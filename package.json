{
  "name": "skills-mcp",
  "version": "1.0.0",
  "description": "MCP server exposing Claude Code style skills (SKILL.md) to harnesses that speak MCP but not skills.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "skills-mcp": "./dist/index.cjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node18 --outfile=dist/index.cjs --banner:js=\"#!/usr/bin/env node\" --sourcemap && chmod +x dist/index.cjs",
    "build:esm": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist/index.js --banner:js=\"#!/usr/bin/env node\" --sourcemap",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.cjs",
    "test": "node test/client.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "yaml": "^2.6.0"
  }
}
